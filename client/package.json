{
  "name": "@refactor-circus/guardian-client",
  "version": "2.0.0",
  "description": "Typed fetch client for Guardian's JSON API, generated from openapi.json.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Refactor-Circus/Guardian.git",
    "directory": "client"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "generate": "openapi-typescript ../openapi.json -o src/schema.d.ts --empty-objects-unknown && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
