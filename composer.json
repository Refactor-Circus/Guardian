{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "refactor-circus/guardian",
    "description": "The Refactor Circus suite's security package: roles and permissions, two-factor, sessions, passwords, API tokens, login protection, SSO and SCIM, served as a JSON API and MCP tools.",
    "keywords": [
        "laravel",
        "refactor-circus",
        "guardian",
        "security",
        "rbac",
        "two-factor",
        "sso",
        "scim"
    ],
    "homepage": "https://github.com/Refactor-Circus/Guardian",
    "license": "MIT",
    "authors": [
        {
            "name": "Jay Fletcher",
            "email": "5743488+jayjfletcher@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.35",
        "pragmarx/google2fa": "^9.1",
        "refactor-circus/keystone": "^2.0"
    },
    "require-dev": {
        "dedoc/scramble": "^0.13.55",
        "firebase/php-jwt": "^7.2.1",
        "larastan/larastan": "^3.13",
        "laravel/mcp": "^1.1",
        "laravel/pao": "^1.1.5",
        "laravel/passport": "^13.12",
        "laravel/pint": "^1.32.1, !=1.32.2",
        "laravel/sanctum": "^4.5",
        "laravel/socialite": "^5.31",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3.4",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-type-coverage": "^5.0.3",
        "phpstan/extension-installer": "^1.4.3",
        "refactor-circus/keen": "^2.0",
        "refactor-circus/ringside": "dev-main",
        "refactor-circus/roster": "^2.0",
        "refactor-circus/standards": "dev-main",
        "socialiteproviders/microsoft-azure": "^5.2.1",
        "socialiteproviders/saml2": "^4.10",
        "web-auth/webauthn-lib": "^5.3.15"
    },
    "autoload": {
        "psr-4": {
            "RefactorCircus\\Guardian\\": "src/",
            "RefactorCircus\\Guardian\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RefactorCircus\\Guardian\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "client:generate": [
            "@php vendor/bin/testbench workbench:openapi openapi.json",
            "npm --prefix client ci",
            "npm --prefix client run generate",
            "@php bin/client-stamp.php"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ],
        "local:install": [
            "@php bin/composer-local.php",
            "@putenv COMPOSER=composer.local.json",
            "@composer install"
        ],
        "local:update": [
            "@php bin/composer-local.php",
            "@putenv COMPOSER=composer.local.json",
            "@composer update"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "RefactorCircus\\Guardian\\GuardianServiceProvider"
            ],
            "aliases": {
                "Guardian": "RefactorCircus\\Guardian\\Facades\\Guardian"
            }
        },
        "atrium": {
            "key": "guardian",
            "scripts": [
                "dist/atrium/atrium.js"
            ],
            "styles": [
                "dist/atrium/atrium.css"
            ]
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "refactor-circus/ringside": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "refactor-circus/roster": "Required for SSO and SCIM only: Guardian signs in and provisions Roster's users and organizations (^2.0). Every other domain works without it.",
        "laravel/mcp": "Manage Guardian from MCP clients and Cortex agents (^1.1).",
        "laravel/socialite": "Required for SSO login (^5.31).",
        "socialiteproviders/saml2": "Required for SAML SSO connections (^4.10).",
        "firebase/php-jwt": "Required for OIDC SSO connections, to verify id_tokens (^7.2).",
        "socialiteproviders/microsoft-azure": "Required for Microsoft Entra ID (Azure) SSO connections (^5.2).",
        "laravel/sanctum": "Manage Sanctum personal access tokens through Guardian's token API (guardian.tokens.driver = sanctum) (^4.5).",
        "laravel/passport": "Manage Passport personal access tokens through Guardian's token API (guardian.tokens.driver = passport) (^13.12).",
        "web-auth/webauthn-lib": "Required for passkeys (WebAuthn) as a second factor (^5.3)."
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Keystone.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Roster.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Keen.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Ringside.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Standards.git"
        }
    ]
}
