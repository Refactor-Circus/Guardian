{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "refactor-circus/guardian",
    "description": "Auth and security for the Refactor Circus suite, starting with SSO and SCIM extracted from Roster",
    "keywords": [
        "laravel",
        "refactor-circus",
        "guardian",
        "sso",
        "scim"
    ],
    "homepage": "https://github.com/Refactor-Circus/Guardian",
    "license": "MIT",
    "authors": [
        {
            "name": "Jay Fletcher",
            "email": "5743488+jayjfletcher@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "refactor-circus/keystone": "dev-main",
        "laravel/framework": "^13.35"
    },
    "require-dev": {
        "firebase/php-jwt": "^7.2.1",
        "larastan/larastan": "^3.13",
        "laravel/mcp": "^1.0.1",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "laravel/socialite": "^5.31",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3.4",
        "pestphp/pest-plugin-browser": "^5.1.2",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-type-coverage": "^5.0.3",
        "phpstan/extension-installer": "^1.4.3",
        "refactor-circus/atrium": "dev-main",
        "refactor-circus/keen": "dev-main",
        "refactor-circus/ringside": "dev-main",
        "refactor-circus/roster": "dev-main",
        "refactor-circus/standards": "dev-main",
        "socialiteproviders/microsoft-azure": "^5.2.1",
        "socialiteproviders/saml2": "^4.10"
    },
    "autoload": {
        "psr-4": {
            "RefactorCircus\\Guardian\\": "src/",
            "RefactorCircus\\Guardian\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RefactorCircus\\Guardian\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test:without-atrium": [
            "vendor/bin/pest tests/Modes/WithoutAtrium"
        ],
        "test:browser": [
            "vendor/bin/pest --testsuite=Browser"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ],
        "local:install": [
            "@php bin/composer-local.php",
            "@putenv COMPOSER=composer.local.json",
            "@composer install"
        ],
        "local:update": [
            "@php bin/composer-local.php",
            "@putenv COMPOSER=composer.local.json",
            "@composer update"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "RefactorCircus\\Guardian\\GuardianServiceProvider"
            ],
            "aliases": {
                "Guardian": "RefactorCircus\\Guardian\\Facades\\Guardian"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "refactor-circus/ringside": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "refactor-circus/roster": "Required for SSO and SCIM: Guardian signs in and provisions Roster's users and organizations, and is inactive without it (dev-main).",
        "refactor-circus/atrium": "Manage SSO connections and SCIM tokens from Roster's organization and user screens in Atrium (dev-main).",
        "laravel/mcp": "Manage SSO connections and SCIM tokens from MCP clients and Cortex agents (^1.0).",
        "laravel/socialite": "Required for SSO login (^5.31).",
        "socialiteproviders/saml2": "Required for SAML SSO connections (^4.10).",
        "firebase/php-jwt": "Required for OIDC SSO connections, to verify id_tokens (^7.2).",
        "socialiteproviders/microsoft-azure": "Required for Microsoft Entra ID (Azure) SSO connections (^5.2)."
    },
    "conflict": {
        "refactor-circus/atrium": "<0.1.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Keystone.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Roster.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Atrium.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Keen.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Ringside.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Standards.git"
        }
    ]
}
