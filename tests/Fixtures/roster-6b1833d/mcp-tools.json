    "RefactorCircus\\Roster\\Domains\\Sso\\Mcp\\Tools\\CreateSsoConnectionTool": {
        "name": "create-sso-connection-tool",
        "title": "Create Sso Connection Tool",
        "description": "Connect an organization to its identity provider. protocol is oidc (issuer, client_id, client_secret), azure for Microsoft Entra ID (tenant, client_id, client_secret) or saml (metadata_url, or entity_id + sso_url + certificate). Returns the callback URL to register at the provider.",
        "inputSchema": {
            "properties": {
                "organization": {
                    "description": "The organization slug.",
                    "type": "string"
                },
                "name": {
                    "description": "Display name, e.g. Okta.",
                    "type": "string"
                },
                "slug": {
                    "description": "URL identifier. Omit to generate one.",
                    "type": "string"
                },
                "protocol": {
                    "description": "oidc, azure or saml.",
                    "type": "string"
                },
                "issuer": {
                    "description": "OIDC: the issuer URL (https), e.g. https://example.okta.com.",
                    "type": "string"
                },
                "tenant": {
                    "description": "Microsoft Entra ID: the tenant ID or verified domain. common/organizations/consumers are refused.",
                    "type": "string"
                },
                "client_id": {
                    "description": "OIDC / Entra ID: the application (client) id.",
                    "type": "string"
                },
                "client_secret": {
                    "description": "OIDC / Entra ID: the client secret. Never returned; omit on update to keep it.",
                    "type": "string"
                },
                "metadata_url": {
                    "description": "SAML: the identity provider metadata URL (preferred).",
                    "type": "string"
                },
                "entity_id": {
                    "description": "SAML without metadata: the IdP entity ID.",
                    "type": "string"
                },
                "sso_url": {
                    "description": "SAML without metadata: the IdP single sign-on URL.",
                    "type": "string"
                },
                "certificate": {
                    "description": "SAML without metadata: the IdP x509 signing certificate.",
                    "type": "string"
                },
                "jit": {
                    "description": "Create accounts on first sign-in for the organization's domains. Defaults to true.",
                    "type": "boolean"
                },
                "enforced": {
                    "description": "Require SSO for the organization's domains. Defaults to false.",
                    "type": "boolean"
                },
                "enabled": {
                    "description": "Defaults to true.",
                    "type": "boolean"
                }
            },
            "type": "object",
            "required": [
                "organization",
                "name",
                "protocol"
            ]
        },
        "annotations": {
            "title": "Create Sso Connection Tool"
        },
        "outputSchema": {
            "properties": {
                "data": {
                    "properties": {
                        "slug": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "protocol": {
                            "enum": [
                                "oidc",
                                "saml",
                                "azure"
                            ],
                            "type": "string"
                        },
                        "organization": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "settings": {
                            "description": "The non-secret settings: issuer, tenant, client_id, metadata_url, entity_id, sso_url.",
                            "type": "object"
                        },
                        "client_secret": {
                            "description": "\"set\" when a client secret is stored.",
                            "enum": [
                                "set",
                                null
                            ],
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "certificate": {
                            "description": "\"set\" when a certificate is stored.",
                            "enum": [
                                "set",
                                null
                            ],
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "jit": {
                            "type": "boolean"
                        },
                        "enforced": {
                            "type": "boolean"
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "sign_in_url": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "callback_url": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "metadata_url": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "identities_count": {
                            "description": "When counted.",
                            "type": "integer"
                        },
                        "created_at": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    },
                    "type": "object",
                    "required": [
                        "slug",
                        "name",
                        "protocol",
                        "organization",
                        "settings",
                        "client_secret",
                        "certificate",
                        "jit",
                        "enforced",
                        "enabled",
                        "sign_in_url",
                        "callback_url",
                        "metadata_url",
                        "created_at"
                    ]
                }
            },
            "type": "object",
            "required": [
                "data"
            ]
        }
    },
